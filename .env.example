# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection string used by src/digital_twin/data/db/session.py
DATABASE_URL=postgresql+psycopg://twin:twin@localhost:5432/digital_twin

# Anthropic API (used by src/digital_twin/agents/*)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
